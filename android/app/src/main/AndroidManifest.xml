<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app is fully offline-first. INTERNET is declared only so that any
         out-of-app links (Help, GitHub, Drive OAuth) can open in the system
         browser; the bundled app never fetches content from the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".LuvinaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Luvina.Splash">

        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Luvina Aura 2x2 Home-Screen Widget Receiver -->
        <receiver
            android:name=".platform.LuvinaAuraWidgetProvider"
            android:exported="true"
            android:label="Luvina Aura Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aura_widget_info" />
        </receiver>

        <!-- The app never fetches remote content, so skip Safe Browsing's
             startup network check against Google's servers — it has nothing
             to protect here and would otherwise contradict the fully-offline
             design. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
    </application>

</manifest>
