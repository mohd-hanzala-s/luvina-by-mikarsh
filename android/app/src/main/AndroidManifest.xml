<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app is fully offline-first. INTERNET is declared only so that any
         out-of-app links (Help, GitHub, Drive OAuth) can open in the system
         browser; the bundled app never fetches content from the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Auto backup is off on purpose. The app's whole premise is "your data
         never leaves this device": the WebView's local storage holds the
         unencrypted IndexedDB (all cycle/symptom/health data) plus, when
         Drive auto-backup is set up, the plaintext passphrase that decrypts
         the user's Drive backup. With allowBackup="true" (the AGP default),
         Android's cloud auto backup — and `adb backup` on older devices —
         would silently copy all of that off-device, which is exactly what
         the app promises not to do. If a real backup need shows up later,
         scope it deliberately with android:dataExtractionRules /
         android:fullBackupContent rather than re-enabling this wholesale. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Luvina">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The app never fetches remote content, so skip Safe Browsing's
             startup network check against Google's servers — it has nothing
             to protect here and would otherwise contradict the fully-offline
             design. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
    </application>

</manifest>
